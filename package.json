{
  "name": "ai-designer-no-figma",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first AI-assisted native Figma design generation",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "build": "node scripts/build.mjs",
    "runtime": "tsx src/runtime/server.ts",
    "mcp": "tsx src/mcp/server.ts",
    "package": "node scripts/package.mjs",
    "package:claude": "node scripts/package-claude-extension.mjs",
    "docs:audit": "node scripts/repository-audit.mjs",
    "docs:validate": "node scripts/repository-audit.mjs --strict",
    "docs:generate": "node scripts/repository-audit.mjs --generate",
    "repo:audit": "node scripts/repository-audit.mjs --strict && npm run audit:local",
    "repo:verify": "npm run verify && npm run docs:validate && npm run compatibility:check",
    "compatibility:check": "node scripts/compatibility-check.mjs",
    "release:verify": "npm run verify && npm run docs:validate && node scripts/release-verify.mjs",
    "verify": "npm run typecheck && npm run lint && npm test && npm run test:integration && npm run build && npm run audit:local && npm run package",
    "audit:local": "node scripts/audit-local.mjs",
    "mcp:remote": "tsx src/mcp/remote.ts",
    "setup:clients": "node scripts/setup-clients.mjs",
    "mcp:hub": "tsx src/mcp/remote.ts",
    "mcp:browser": "tsx src/mcp/remote.ts --tunnel",
    "bench": "tsx tools/benchmark/benchmark.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "ajv": "^8.17.1",
    "localtunnel": "^2.0.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.117.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/localtunnel": "^2.0.4",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.25.5",
    "eslint": "^9.29.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.3.5",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.1",
    "axios": "^1.12.2"
  }
}
